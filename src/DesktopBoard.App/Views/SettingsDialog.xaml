<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="DesktopBoard.App.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fx="using:DesktopBoard.App.Converters"
    Title="{x:Bind ViewModel.Strings.SettingsTitle}"
    CloseButtonText="{x:Bind ViewModel.Strings.Close}"
    DefaultButton="Close"
    FlowDirection="{x:Bind Flow}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">900</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="640">
        <StackPanel Spacing="14" MinWidth="480" Margin="0,4,8,4">

            <ToggleSwitch Header="{x:Bind ViewModel.Strings.StartWithWindows}" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />

            <StackPanel Spacing="6">
                <TextBlock Text="{x:Bind ViewModel.Strings.BackgroundImage}" Style="{StaticResource SecondaryText}" />
                <TextBlock Text="{x:Bind ViewModel.BackgroundImageDisplay, Mode=OneWay}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{x:Bind ViewModel.Strings.ChooseImage}" Click="ChooseImage_Click" />
                    <Button Content="{x:Bind ViewModel.Strings.UseWindowsWallpaper}" Command="{x:Bind ViewModel.UseWindowsWallpaperCommand}" />
                </StackPanel>
            </StackPanel>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Slider Header="{x:Bind ViewModel.Strings.Darkness}" Minimum="0" Maximum="0.9" StepFrequency="0.05" Value="{x:Bind ViewModel.Darkness, Mode=TwoWay}" Style="{StaticResource BoardSlider}" />
                <TextBlock Grid.Column="1" Text="{x:Bind fx:Fx.Percent(ViewModel.Darkness), Mode=OneWay}" Style="{StaticResource SecondaryText}" VerticalAlignment="Bottom" Margin="0,0,0,8" MinWidth="40" />
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Slider Header="{x:Bind ViewModel.Strings.Blur}" Minimum="0" Maximum="1" StepFrequency="0.05" Value="{x:Bind ViewModel.Blur, Mode=TwoWay}" Style="{StaticResource BoardSlider}" />
                <TextBlock Grid.Column="1" Text="{x:Bind fx:Fx.Percent(ViewModel.Blur), Mode=OneWay}" Style="{StaticResource SecondaryText}" VerticalAlignment="Bottom" Margin="0,0,0,8" MinWidth="40" />
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Slider Header="{x:Bind ViewModel.Strings.UiScale}" Minimum="0.75" Maximum="1.5" StepFrequency="0.05" Value="{x:Bind ViewModel.UiScale, Mode=TwoWay}" Style="{StaticResource BoardSlider}" />
                <TextBlock Grid.Column="1" Text="{x:Bind fx:Fx.Scale(ViewModel.UiScale), Mode=OneWay}" Style="{StaticResource SecondaryText}" VerticalAlignment="Bottom" Margin="0,0,0,8" MinWidth="40" />
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Slider Header="{x:Bind ViewModel.Strings.InsetLeft}" Minimum="0" Maximum="400" StepFrequency="10" Value="{x:Bind ViewModel.InsetLeft, Mode=TwoWay}" Style="{StaticResource BoardSlider}" />
                <TextBlock Grid.Column="1" Text="{x:Bind fx:Fx.Px(ViewModel.InsetLeft), Mode=OneWay}" Style="{StaticResource SecondaryText}" VerticalAlignment="Bottom" Margin="0,0,0,8" MinWidth="40" />
            </Grid>

            <ComboBox Header="{x:Bind ViewModel.Strings.LanguageLabel}" SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="{x:Bind ViewModel.Strings.LangBilingual}" />
                <ComboBoxItem Content="{x:Bind ViewModel.Strings.LangFa}" />
                <ComboBoxItem Content="{x:Bind ViewModel.Strings.LangEn}" />
            </ComboBox>

            <ToggleSwitch Header="{x:Bind ViewModel.Strings.DefaultLocked}" IsOn="{x:Bind ViewModel.DefaultLocked, Mode=TwoWay}" />
            <ToggleSwitch Header="{x:Bind ViewModel.Strings.HoldToUnlockSetting}" IsOn="{x:Bind ViewModel.HoldToUnlock, Mode=TwoWay}" />
            <ToggleSwitch Header="{x:Bind ViewModel.Strings.GlassEffect}" IsOn="{x:Bind ViewModel.GlassEnabled, Mode=TwoWay}" />

            <ComboBox Header="{x:Bind ViewModel.Strings.DesktopMode}" SelectedIndex="{x:Bind ViewModel.DesktopModeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="{x:Bind ViewModel.Strings.ModeAuto}" />
                <ComboBoxItem Content="{x:Bind ViewModel.Strings.ModeEmbedded}" />
                <ComboBoxItem Content="{x:Bind ViewModel.Strings.ModeBottomMost}" />
                <ComboBoxItem Content="{x:Bind ViewModel.Strings.ModeNormal}" />
            </ComboBox>
            <TextBlock Text="{x:Bind ViewModel.Strings.RestartHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{x:Bind ViewModel.Strings.ResetLayout}" Command="{x:Bind ViewModel.ResetLayoutCommand}" IsEnabled="{x:Bind ViewModel.IsEditMode}" />
                <Button Content="{x:Bind ViewModel.Strings.ExportBackup}" Click="Export_Click" />
                <Button Content="{x:Bind ViewModel.Strings.ImportBackup}" Click="Import_Click" IsEnabled="{x:Bind ViewModel.IsEditMode}" />
            </StackPanel>

            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Foreground="{StaticResource SuccessBrush}"
                       Visibility="{x:Bind fx:Fx.VisIfText(ViewModel.Status), Mode=OneWay}" />

            <StackPanel Spacing="2">
                <TextBlock Text="{x:Bind ViewModel.Strings.DataFolder}" Style="{StaticResource MutedText}" />
                <TextBlock Text="{x:Bind ViewModel.DataFolderPath}" Style="{StaticResource MutedText}" IsTextSelectionEnabled="True" FlowDirection="LeftToRight" />
            </StackPanel>

            <Button Content="{x:Bind ViewModel.Strings.ExitApp}" Click="Exit_Click" HorizontalAlignment="Left" Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
