<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:media="using:Microsoft.UI.Xaml.Media">

    <!-- Base palette: dark navy / charcoal with restrained accents. -->
    <Color x:Key="BoardBackdropColor">#0B1220</Color>
    <Color x:Key="CardTintColor">#0C1424</Color>
    <Color x:Key="CardBorderColor">#2EFFFFFF</Color>
    <Color x:Key="CardBorderSoftColor">#1AFFFFFF</Color>
    <Color x:Key="TextPrimaryColor">#F1F5F9</Color>
    <Color x:Key="TextSecondaryColor">#A5B4C7</Color>
    <Color x:Key="TextMutedColor">#6B7A90</Color>

    <Color x:Key="WorkAccentColor">#60A5FA</Color>
    <Color x:Key="WorkAccent2Color">#A78BFA</Color>
    <Color x:Key="PersonalAccentColor">#FB7185</Color>
    <Color x:Key="PersonalAccent2Color">#FB923C</Color>
    <Color x:Key="SuccessColor">#4ADE80</Color>

    <SolidColorBrush x:Key="BoardBackdropBrush" Color="{StaticResource BoardBackdropColor}" />
    <SolidColorBrush x:Key="CardSolidBrush" Color="#C40C1424" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
    <SolidColorBrush x:Key="CardBorderSoftBrush" Color="{StaticResource CardBorderSoftColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="WorkAccentBrush" Color="{StaticResource WorkAccentColor}" />
    <SolidColorBrush x:Key="WorkAccent2Brush" Color="{StaticResource WorkAccent2Color}" />
    <SolidColorBrush x:Key="PersonalAccentBrush" Color="{StaticResource PersonalAccentColor}" />
    <SolidColorBrush x:Key="PersonalAccent2Brush" Color="{StaticResource PersonalAccent2Color}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="PressedBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="DividerBrush" Color="#24FFFFFF" />

    <!-- In-app acrylic: blurs the wallpaper that the board draws behind the cards. -->
    <media:AcrylicBrush x:Key="CardGlassBrush"
                        TintColor="{StaticResource CardTintColor}"
                        TintOpacity="0.55"
                        TintLuminosityOpacity="0.72"
                        FallbackColor="#D90C1424" />

    <media:AcrylicBrush x:Key="PillGlassBrush"
                        TintColor="#141C2E"
                        TintOpacity="0.6"
                        TintLuminosityOpacity="0.8"
                        FallbackColor="#E6141C2E" />

    <LinearGradientBrush x:Key="WorkUnderlineBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#60A5FA" Offset="0" />
        <GradientStop Color="#A78BFA" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PersonalUnderlineBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FB923C" Offset="0" />
        <GradientStop Color="#FB7185" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
