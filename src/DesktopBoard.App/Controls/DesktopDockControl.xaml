<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DesktopBoard.App.Controls.DesktopDockControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DesktopBoard.App.ViewModels"
    xmlns:fx="using:DesktopBoard.App.Converters"
    FlowDirection="LeftToRight"
    IsTabStop="False">

    <UserControl.Resources>
        <!-- one desktop icon: launches on click, like a dock -->
        <DataTemplate x:Key="DockItemTemplate" x:DataType="vm:DesktopItemViewModel">
            <Button Command="{x:Bind LaunchCommand}" Width="84" Height="86" Padding="4,6,4,4" Margin="2"
                    Background="Transparent" BorderThickness="0" CornerRadius="10"
                    ToolTipService.ToolTip="{x:Bind Name}" HorizontalContentAlignment="Center" VerticalContentAlignment="Top">
                <Button.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="باز کردن / Open" Command="{x:Bind LaunchCommand}" />
                        <MenuFlyoutItem Text="نمایش در پوشه / Show in folder" Command="{x:Bind ShowInFolderCommand}" />
                    </MenuFlyout>
                </Button.ContextFlyout>
                <StackPanel Spacing="3">
                    <Image Source="{x:Bind Icon}" Width="40" Height="40" HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind Name}" FontFamily="{StaticResource BoardFont}" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}"
                               TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" LineHeight="14" Width="76" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root" SizeChanged="Root_SizeChanged">
        <!-- glass strip, same language as the cards -->
        <Border Background="{StaticResource CardGlassBrush}" CornerRadius="16" />
        <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" />
        <ScrollViewer Style="{StaticResource BoardScrollViewer}" Padding="4,6" IsTabStop="False">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}" ItemTemplate="{StaticResource DockItemTemplate}" HorizontalAlignment="Center">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MaximumRowsOrColumns="{x:Bind ViewModel.Columns, Mode=OneWay}" Orientation="Horizontal"
                                       ItemsStretch="None" MinItemWidth="88" MinItemHeight="90" MinRowSpacing="0" MinColumnSpacing="0" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>
        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="28" Height="28" VerticalAlignment="Top" Margin="0,12,0,0"
                      Visibility="{x:Bind fx:Fx.Vis(ViewModel.IsLoading), Mode=OneWay}" />
    </Grid>
</UserControl>
