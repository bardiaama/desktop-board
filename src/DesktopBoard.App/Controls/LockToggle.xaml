<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DesktopBoard.App.Controls.LockToggle"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fx="using:DesktopBoard.App.Converters"
    IsTabStop="True"
    UseSystemFocusVisuals="True"
    FlowDirection="LeftToRight">

    <Grid x:Name="Root" Height="58" MinWidth="300" CornerRadius="29"
          Background="{StaticResource PillGlassBrush}"
          BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
          Padding="18,0,14,0"
          PointerPressed="Root_PointerPressed"
          PointerReleased="Root_PointerReleased"
          PointerExited="Root_PointerExited"
          PointerCanceled="Root_PointerExited"
          PointerCaptureLost="Root_PointerExited"
          Shadow="{StaticResource CardShadow}" Translation="0,0,20">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LockStates">
                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.18" />
                </VisualStateGroup.Transitions>
                <VisualState x:Name="Locked" />
                <VisualState x:Name="Unlocked">
                    <VisualState.Setters>
                        <Setter Target="KnobTranslate.X" Value="24" />
                        <Setter Target="Track.Background" Value="{StaticResource WorkAccentBrush}" />
                        <Setter Target="Track.BorderBrush" Value="{StaticResource WorkAccentBrush}" />
                        <Setter Target="Icon.Glyph" Value="&#xE785;" />
                        <Setter Target="Icon.Foreground" Value="{StaticResource WorkAccentBrush}" />
                        <Setter Target="IconBox.Background" Value="#2660A5FA" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border x:Name="IconBox" Width="34" Height="34" CornerRadius="10" Background="#1AFFFFFF" VerticalAlignment="Center">
            <FontIcon x:Name="Icon" Glyph="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" />
        </Border>

        <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource BodyText}" FontSize="16" FontWeight="SemiBold" LineHeight="20" />
            <TextBlock x:Name="SubtitleText" Text="{x:Bind Subtitle, Mode=OneWay}" Style="{StaticResource SecondaryText}" FontSize="12.5" LineHeight="16" />
        </StackPanel>

        <!-- switch track -->
        <Border x:Name="Track" Grid.Column="2" Width="50" Height="26" CornerRadius="13" Background="#33FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" VerticalAlignment="Center">
            <Grid>
                <Ellipse x:Name="Knob" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0" VerticalAlignment="Center">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="KnobTranslate" X="0" />
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>
        </Border>

        <!-- hold progress -->
        <Grid Grid.ColumnSpan="3" VerticalAlignment="Bottom" Height="3" Margin="24,0,24,6" CornerRadius="2" Background="#14FFFFFF">
            <Rectangle x:Name="HoldBar" HorizontalAlignment="Left" Width="0" Fill="{StaticResource WorkAccentBrush}" RadiusX="2" RadiusY="2" />
        </Grid>
    </Grid>
</UserControl>
